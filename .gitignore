# ==============================================================================
# Air Quality Monitoring & Forecasting System - Root .gitignore
# Covers: Java / Maven (Spring Boot), React / Node.js (Vite), Python (FastAPI/TF),
#         IDEs (IntelliJ, VS Code, Eclipse), Operating Systems (Windows, macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables (Never commit real credentials)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!*.env.example

# ------------------------------------------------------------------------------
# Node.js / React (frontend)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Java / Maven (backend)
# ------------------------------------------------------------------------------
target/
backend/target/
*.class
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# Python (ml-service)
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ipynb_checkpoints
*/.ipynb_checkpoints/
.matplotlib/

# Virtual Environments
venv/
venv*/
*/venv/
*/venv*/
ENV/
env/
*/env/

# Training and Run Logs
*.log
ml-service/*.log
backend/*.log
backend/test_output*.log
ml-service/check_output.txt
ml-service/phase2_output*.txt
ml-service/phase2_eda_output.txt
ml-service/training_output.txt

# ------------------------------------------------------------------------------
# Preserve Machine Learning Model Artifacts & Pretrained Scalers
# ------------------------------------------------------------------------------
!ml-service/models/lstm_aqi_model.keras
!ml-service/data/processed/scaler_features.pkl
!ml-service/data/processed/scaler_target.pkl
!ml-service/data/processed/*.npy

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
build/
nbbuild/
nbdist/
.nb-gradle/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
