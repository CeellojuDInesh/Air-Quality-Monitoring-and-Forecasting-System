# ==============================================================================
# Air Quality Monitoring & Forecasting Platform - Environment Configuration Template
# ==============================================================================
# Copy or export these environment variables before running the application components.

# ------------------------------------------------------------------------------
# 1. MySQL Database Configuration (Spring Boot Backend & Seed Script)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/air_quality_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1:3306
DB_NAME=air_quality_db

# ------------------------------------------------------------------------------
# 2. FastAPI ML Service Configuration
# ------------------------------------------------------------------------------
FASTAPI_URL=http://localhost:8000
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ------------------------------------------------------------------------------
# 3. React Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Open-Meteo External API URLs (Proxy via Spring Boot)
# ------------------------------------------------------------------------------
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
